#!/bin/sh
# pre-commit hook for workspace_openclaw
# Runs syntax and lightweight tests before every commit.
#
# Install:
#   cp scripts/pre-commit.template .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

# Determine the repository root regardless of where this hook lives
SCRIPT_DIR=$(git rev-parse --show-toplevel)

# Only run full tests if skills/ or scripts/ changed
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
SKILL_OR_SCRIPT_CHANGED=$(echo "$CHANGED" | grep -qE '^(skills/|scripts/)' && echo 1 || echo 0)

# Frontera de roles (ADR-083): el ciclo SDD de un rol NO vive en el arbol del Core.
# Disparador PROPIO, no el de arriba: la violacion se comete cambiando
# `agents/<rol>/skills/`, que `SKILL_OR_SCRIPT_CHANGED` no matchea. Conectarlo al
# bloque de skills/scripts/ dejaba el check sin correr justo en el caso que existe
# para cazar - verificado 2026-09-29: con `skills/hermes-builder/SKILL.md` staged,
# el hook salia 0. El check es python puro (barato): corre ante cualquier cambio
# bajo skills/, scripts/ o agents/.
BOUNDARY_RELEVANT=$(echo "$CHANGED" | grep -qE '^(skills/|scripts/|agents/)' && echo 1 || echo 0)

# Pacto del pipeline A/B (ADR-077/ADR-088). Disparador propio: lo que declara los
# modelos vive en scripts/, skills/ y el ADR (docs/). Si una fuente deriva de las
# otras, el pacto tiene dos verdades. Verificado 2026-10-05: el CORE delego una
# sesion entera con un solo agente y el default del rol; la regla estaba escrita y
# nada la verificaba. Python puro (barato): corre ante cualquier cambio relevante.
PACTO_RELEVANT=$(echo "$CHANGED" | grep -qE '^(scripts/|skills/|docs/|AGENTS\.md)' && echo 1 || echo 0)

# Grafo de supersede de ADRs (2026-10-09). Disparador propio, docs/adr/: una
# relacion se declara o se rompe editando un ADR (.md) o dejando un sidecar
# (no-.md). El trigger de markdown (MD_CHANGED) no veria el sidecar, que es justo
# el caso que se cazo (el `.appendix` de ADR-006). Por eso mira el directorio, no
# la extension.
ADR_RELEVANT=$(echo "$CHANGED" | grep -qE '^docs/adr/' && echo 1 || echo 0)

# HANDOFF merge (2026-11-04). Disparador propio: cualquier HANDOFF staged bajo
# `.knowledge/` puede haber PISADO pendientes heredados en vez de fusionarlos.
# La regla estaba escrita en session-close-handoff paso 3 y se violo igual el
# 2026-11-04 (se perdieron 8 pendientes de la sesion de las 16:10). Una regla
# escrita y no verificada se viola sola: mismo defecto que ADR-077.
HANDOFF_RELEVANT=$(echo "$CHANGED" | grep -qE '\.knowledge/HANDOFF\.md$' && echo 1 || echo 0)

# Design system (2026-10-06). Disparador propio: los tokens viven en design/.
# El build resuelve referencias y el guard mide contraste WCAG. El principio
# "contraste verificado, no sentido" era falso (nada lo media); esto lo hace
# verificable. Ver ADR-095.
DESIGN_RELEVANT=$(echo "$CHANGED" | grep -qE '^design/' && echo 1 || echo 0)

# --- Chequeos baratos: SIEMPRE que haya markdown staged ---
# Por que: la regla del guion comun y las rutas citadas se cumplian solo
# dentro de skills/ (test-skills.sh mira unicamente $SKILLS_DIR). Asi se
# acumularon 44 en dash y 2 rutas rotas en docs/ sin que nada las viera.
MD_CHANGED=$(echo "$CHANGED" | grep -E '\.md$' || true)

# Contenido NUEVO: markdown que cambio de bytes. Un rename puro (R100) es un
# movimiento byte-identico: no introduce guiones ni rutas, y bloquearlo por
# guiones heredados rompe cualquier reorganizacion masiva de archivos viejos
# (encontrado 2026-09-29: mover 445 dailies/sesiones quedo trabado por 200
# archivos historicos con em dash que nadie edito). Las reglas de contenido
# (guion, re-stage) aplican solo a MD_CONTENT; las de corpus (refs, ADR) siguen
# corriendo si hay cualquier MD staged.
MD_CONTENT=$(git diff --cached --name-status -M | awk -F'\t' '
  $1 ~ /^R/ { if ($1 != "R100") print $3; next }
  $1 ~ /^D/ { next }
  { print $2 }
' | grep -E '\.md$' || true)

# Excepcion explicita a la regla del guion comun: (1) las novelas en
# docs/stories/ usan la raya (U+2014) como raya de dialogo
# (decision de Gonzo 2026-09-24, registrada en STYLE.md: "no corregir");
# quienes_quedan desde entonces, las_tres_sabanas desde 2026-10-12 (misma
# convencion, declarada en su STYLE.md);
# (2) la historia congelada (docs/archive/ y memory/archive/, 2026-10-06) se
# lee como se escribio - bloques rotados de CHANGELOG/DREAMS citan texto con
# em dash y no se reescriben (misma politica que docs/records/, ADR-084).
# El CI no chequea guiones; esto solo evita que el hook bloquee cada edicion.
# ADR-082 retiro la regla del guion como obligacion; el aparato sigue y quien
# la padezca decide si lo desarma.
MD_EXEMPT='^docs/stories/quienes_quedan/|^docs/stories/las_tres_sabanas/|^docs/archive/|^docs/archives/|^memory/archive/'
MD_RULE=$(echo "$MD_CONTENT" | grep -vE "$MD_EXEMPT" || true)

if [ -n "$MD_CHANGED" ]; then
  # 0) Guiones: sin gate y sin reescritura (2026-11-09, "no debe estar restringido
  #    en ninguna parte"). Se retiro el hyphen_enforcer, que reescribia en-dash a
  #    guion comun DENTRO de los archivos staged en cada commit, y tambien el
  #    aviso por guion largo. ADR-082 retiro la regla del guion comun obligatorio
  #    y la regla 13 de docs/voz-gonzo.md lo declara criterio laxo: el texto del
  #    autor se commitea como esta.
  if [ -n "$MD_RULE" ]; then
    :
  fi

  # 2) Rutas citadas: cada `docs/...` o `scripts/...` debe existir.
  python3 "${SCRIPT_DIR}/scripts/check-refs.py" --all || exit 1

  # 3) CHANGELOG en ventana: el activo (docs/CHANGELOG.md) muestra solo los ultimos ~14 dias; lo
  #    viejo vive archivado. Antes crecia sin control (310 KB al 2026-10-06).
  #    Solo corre si el propio docs/CHANGELOG.md esta staged: no bloquea commits
  #    ajenos por un archivo que nadie toco. El cierre de sesion rota solo.
  if echo "$MD_CHANGED" | grep -q '^docs/CHANGELOG\.md$'; then
    python3 "${SCRIPT_DIR}/scripts/changelog-rotate.py" --check || exit 1
  fi

  # 4) Corpus de ADRs: disco vs indice reconciliados. check-refs valida que una
  #    ruta citada exista, NO la direccion inversa: un ADR-063 sin fila en el
  #    indice pasaba limpio. Un ADR fuera del indice es un ADR que nadie encuentra.
  python3 "${SCRIPT_DIR}/scripts/check-adr-integrity.py" || exit 1
fi

# --- Gate de accesibilidad: el boundary de la skill a11y-at-validation ---
# Por que no vive dentro del bloque de markdown: el disparador es el codigo de
# UI (aria-*, roles, foco), no los docs. Si el cambio afecta lo que ANUNCIA el
# screen reader, la validacion manual con AT es obligatoria (caso radix #4109:
# DOM correcto, 51 tests verdes, y el option no anunciaba nada). Un script no
# puede validar el anuncio; si puede no dejar pasar el cambio en silencio.
# Override consciente: A11Y_VALIDATED=1 (documentar la evidencia en el PR).
if [ -n "$CHANGED" ]; then
  python3 "${SCRIPT_DIR}/scripts/check-a11y-trigger.py" || exit 1
fi

# Guard de fuente unica (ADR-100, 2026-10-20). SIN CONDICION, a proposito: la
# duplicacion que este gate caza nace de una edicion en CUALQUIER archivo
# normativo, no de un pathspec predecible. El caso testigo no fue un cambio
# grande: fue una linea de estado agregada a MEMORY.md que ya vivia en
# AGENTS.md, y un bloque de modelos en SETUP.md que se declaraba vigente y
# superseded en la misma frase. Python puro (lee ~9 archivos): correrlo siempre
# es mas barato que descubrir la contradiccion en la sesion siguiente.
python3 "${SCRIPT_DIR}/scripts/check-single-source.py" || exit 1

# Guard de hechos de carrera (ADR-101, 2026-10-20). SIN CONDICION: un CV se
# escribe desde cualquier carpeta y el hecho duro (anos, idioma, fechas,
# certificaciones) no tiene por que tocarse para que el CV derive. Medido el
# 2026-10-20: 5 CVs vivos con 3 verdades distintas sobre la misma persona
# (9+ vs 10+ anios, 6+ vs ~5 de a11y, "Advanced" contra una regla de B2).
# Tambien FRENA un hecho marcado `pending`: una contradiccion sin decidir no se
# commitea para arreglarla despues.
python3 "${SCRIPT_DIR}/scripts/check-cv-facts.py" || exit 1

# Guard de directorios de contenido (2026-09-30). SIN CONDICION, a proposito.
# Lo que detecta - un directorio de contenido que desaparece - es INVISIBLE a los
# filtros de diff: el commit dfa94759 borro TODO studies/ y no aparecio en CHANGED,
# porque --diff-filter=ACMR excluye justamente las bajas (D). Un trigger que
# dependa del diff no puede ver lo que el diff no reporta. Es python puro (10
# stat()): correrlo siempre es mas barato que dejar el agujero abierto.
# Disparador gemelo de la leccion: una guarda de referencias no es una guarda de
# existencia.
python3 "${SCRIPT_DIR}/scripts/check-content-dirs.py" || exit 1

# Guard del budget de bootstrap (2026-10-06, ROADMAP 0.1). SIN CONDICION, a
# proposito: los archivos que OpenClaw inyecta en cada arranque (AGENTS/MEMORY/
# USER/SOUL/IDENTITY) se truncan EN SILENCIO al superar su cap; el agente arranca
# sin esas reglas y no lo sabe. Un archivo de bootstrap puede crecer por
# cualquier edicion, no solo por un pathspec predecible, asi que el trigger no
# puede depender del diff. Python puro (lee 5 archivos): correrlo siempre es mas
# barato que dejar el agujero abierto. Caps verificados en el runtime: 20.000
# (AGENTS/MEMORY/SOUL/IDENTITY), 4.000 (USER fijo), 60.000 total.
python3 "${SCRIPT_DIR}/scripts/check-bootstrap-budget.py" || exit 1

# Guard de integridad de la tabla learnings (2026-10-27). SIN CONDICION, a
# proposito: la tabla se modifica desde memory-db.sh add-learning, desde
# memory-catalog-v2.py y desde las migraciones, y el dano NO aparece en el
# diff. Caso testigo: yo borre 9 lecciones REALES con un DELETE que buscaba
# `content` vacio, porque el cuerpo de la leccion esta en `content`... salvo
# en las filas donde alguien lo habia dejado en `title` o en `tags`. El
# export a docs/learnings/*.md lee el cuerpo de `content`, asi que esas
# lecciones se veian como seccion vacia y nadie lo notaba.
# El gate separa PERDIDA (bloquea) de RUIDO HISTORICO (avisa): un guard que
# reporta 169 filas no se lee y no se respeta.
python3 "${SCRIPT_DIR}/scripts/check-learnings-integrity.py" || exit 1

# Guard de fuente unica (ADR-100, 2026-10-20). SIN CONDICION, a proposito: la
# duplicacion que este gate caza nace de una edicion en CUALQUIER archivo
# normativo, no de un pathspec predecible. El caso testigo no fue un cambio
# grande: fue una linea de estado agregada a MEMORY.md que ya vivia en
# AGENTS.md, y un bloque de modelos en SETUP.md que se declaraba vigente y
# superseded en la misma frase. Python puro (lee ~9 archivos): correrlo siempre
# es mas barato que descubrir la contradiccion en la sesion siguiente.
python3 "${SCRIPT_DIR}/scripts/check-single-source.py" || exit 1

# Guard de hechos de carrera (ADR-101, 2026-10-20). SIN CONDICION: un CV se
# escribe desde cualquier carpeta y el hecho duro (anos, idioma, fechas,
# certificaciones) no tiene por que tocarse para que el CV derive. Medido el
# 2026-10-20: 5 CVs vivos con 3 verdades distintas sobre la misma persona
# (9+ vs 10+ anios, 6+ vs ~5 de a11y, "Advanced" contra una regla de B2).
# Tambien FRENA un hecho marcado `pending`: una contradiccion sin decidir no se
# commitea para arreglarla despues.
python3 "${SCRIPT_DIR}/scripts/check-cv-facts.py" || exit 1

# Guard de roadmaps de rol (docs/ROADMAPS.md, 2026-10-07). SIN CONDICION, a
# proposito: los ROADMAP.md de rol pueden aparecer o desaparecer por cualquier
# edicion, no por un pathspec predecible. El 2026-10-07 se descubrio que 5 de 7
# roles NO tenian roadmap y nada lo detectaba; una regla sin guarda se viola
# sola (ADR-083). Verifica existencia, encabezado, secciones, marcador de
# proyecto y COHERENCIA de version contra el indice. Python puro (lee 8
# archivos): correrlo siempre es mas barato que dejar el agujero abierto.
python3 "${SCRIPT_DIR}/scripts/check-roadmaps.py" || exit 1

# Guarda de `.knowledge/` ajeno (2026-11-03, pedido de Gonzo: "no ensuciar lo
# ajeno"). SIN CONDICION, a proposito: un fork o clon nuevo puede aparecer por
# cualquier operacion y el hook pre-push de ESE repo es lo unico que impide que
# su `.knowledge/` viaje a upstream. Un repo de terceros sin la guarda no da
# error en ningun otro lado - el push sale y contamina. Python puro (stat y
# `git remote`): correrlo siempre es mas barato que dejar el agujero abierto.
if ! python3 "${SCRIPT_DIR}/scripts/check-foreign-knowledge.py"; then
  echo ""
  echo "  La guarda vive en .git/hooks del repo ajeno y no se commitea:"
  echo "  instalala con scripts/check-foreign-knowledge.py --install"
  exit 1
fi

if [ "$BOUNDARY_RELEVANT" = "1" ]; then
  # Frontera de roles (ADR-083): el ciclo SDD no vive en el arbol del Core. El Core
  # tenia el playbook de ingenieria a la vista y lo ejecuto durante una sesion
  # entera. Disparador propio (ver arriba), no el de skills/scripts/.
  python3 "${SCRIPT_DIR}/scripts/check-agent-skill-boundary.py" || exit 1
fi

# Guard de solapamiento entre skills (2026-11-06, paso 4 - skill-router-improvement).
# AVISO, no bloqueo: solo si skills/agents cambian, solo las SKILL.md staged.
# El scan completo se reserva a mano / CI (--all).
if [ "$BOUNDARY_RELEVANT" = "1" ]; then
  python3 "${SCRIPT_DIR}/scripts/check-skill-overlap.py" --staged --own-only --blocking 2>&1 | sed 's/^/    /' || { echo "    (solapamiento interno > 0.87; resolver o usar --no-verify)"; exit 1; }
fi

# Gate de la cadena OSS -> LinkedIn (2026-10-22). Disparador PROPIO: solo corren
# los posts STAGED en docs/linkedin/. El modo auditoria de este script NO se
# conecta a proposito: el backlog medido (5 drafts vencidos, 2 merges sin post)
# bloquearia TODO commit del workspace, y un guard que bloquea todo no es un
# guard, es una pared. La auditoria de cierre se corre a mano, o por
# automatizacion, cuando el backlog este limpio.
#
# Por que este gate existia y faltaba: la skill `linkedin-merge-post` (workshop de
# MIND) exige en su paso 6 "clear both publish gates", uno de los cuales era el
# "anti-ai pass" de `skills/anti-ai` - skill que NO existe (eliminada el
# 2026-09-22, ya era placeholder). El paso 6 era inejecutable. Este script
# restituye el gate con las reglas ORIGINALES de ese `anti-ai`, recuperadas del
# historial (commit c0182f17), no inventadas.
if echo "$CHANGED" | grep -q '^docs/linkedin/'; then
  LINKEDIN_BAD=0
  for f in $(echo "$CHANGED" | grep '^docs/linkedin/.*\.md$'); do
    if ! git show ":$f" 2>/dev/null | python3 "${SCRIPT_DIR}/scripts/check-linkedin-pipeline.py" --post - >/dev/null 2>&1; then
      echo "  post de LinkedIn que no pasa el gate: $f"
      git show ":$f" | python3 "${SCRIPT_DIR}/scripts/check-linkedin-pipeline.py" --post - 2>&1 | sed 's/^/    /'
      LINKEDIN_BAD=1
    fi
  done
  [ "$LINKEDIN_BAD" = "1" ] && { echo "ABORT: el post tiene que pasar el gate de la cadena."; exit 1; }
fi

# Gate de seguridad del codigo de skills (2026-10-06). Se instalan skills de
# afuera; el codigo ejecutable que entra bajo un arbol de skills se escanea
# antes de commitear. --staged esta SCOPEADO a codigo de skills: el codigo
# propio de scripts/ se auto-marcaria falsos positivos (security-scan cita
# /etc/passwd como patron, los triggers .js usan exec(), test-skills.sh navega
# ./../..). Corre ante cambios de skills/ o agents/ (donde viven las skills).
if [ "$BOUNDARY_RELEVANT" = "1" ]; then
  python3 "${SCRIPT_DIR}/scripts/security-scan.py" --staged || exit 1
fi


if [ "$HANDOFF_RELEVANT" = "1" ]; then
  # El HANDOFF es el mapa de TODO lo pendiente del sujeto, no el acta de la
  # ultima sesion. Si un pendiente o una decision del HANDOFF anterior desaparecio
  # sin estar declarado en CERRADOS, el cierre lo borro por olvido.
  for HO in $(echo "$CHANGED" | grep -E '\.knowledge/HANDOFF\.md$'); do
    python3 "${SCRIPT_DIR}/scripts/check-handoff-merge.py" --new "$HO" || exit 1
  done
fi

if [ "$PACTO_RELEVANT" = "1" ]; then
  # Pacto del pipeline A/B (ADR-077/ADR-088): router, managed-blocks, skill y ADR
  # deben declarar el MISMO A/B, con A != B. Una deriva es un pacto con dos
  # verdades; el CORE puede citar la conveniente.
  python3 "${SCRIPT_DIR}/scripts/check-pipeline-enforcement.py" || exit 1
fi

if [ "$ADR_RELEVANT" = "1" ]; then
  # Grafo de supersede (2026-10-09): un ADR que declara superseder a otro exige que
  # el reemplazado lo diga en su ESTADO. check-adr-integrity reconcilia indice vs
  # disco (que el ADR se encuentre), no la DIRECCION de la relacion (que el pisado
  # lo diga): un ADR "encontrable" pero "pisado" se lee como ley vigente. Y un
  # archivo no-.md en docs/adr/ (sidecar) es invisible para todo lector y guard.
  python3 "${SCRIPT_DIR}/scripts/check-adr-supersede.py" || exit 1
fi

if [ "$DESIGN_RELEVANT" = "1" ]; then
  # Design system (ADR-095): regenerar el CSS (referencias resueltas) y verificar
  # que los tokens cumplan su piso WCAG. Un cambio de token no entra en silencio.
  python3 "${SCRIPT_DIR}/design/tokens/build-tokens.py" >/dev/null || exit 1
  python3 "${SCRIPT_DIR}/scripts/check-design-tokens.py" --check || exit 1
fi

if [ "$SKILL_OR_SCRIPT_CHANGED" = "1" ]; then
  # 0) Ensure every SKILL.md has front‑matter before running skill tests
  ./scripts/frontmatter_validator.sh
  # Re-stage SOLO los SKILL.md que forman parte de este commit y que el
  # validator pudo haber corregido. Antes se re-stageaba todo `skills/**/*.md`:
  # `git add` sobre un archivo con cambios sin stagear los mete al commit (barrido
  # de cambios ajenos), y el pathspec `skills/*/SKILL.md` es un path LITERAL
  # trackeado que git expandia como glob y stageaba las skills borradas.
  for f in $MD_CHANGED; do
    case "$f" in
      */SKILL.md) [ -f "$f" ] && git --literal-pathspecs add -- "$f" ;;
    esac
  done

  # Syntax checks for skill scripts
  "${SCRIPT_DIR}/scripts/test-skills.sh" || exit 1

  # Bash functional tests (bats)
  # GIT_INDEX_FILE: con `git commit -- <paths>` git pasa al hook un indice
  # TEMPORAL por path ABSOLUTO (.git/next-index-<pid>.lock). Si un test hace
  # `git -C "$TMP" add ...`, hereda esa variable y escribe la entrada en el
  # indice del repo real, mientras lee el blob del repo temporal: el commit
  # muere con "invalid object ... Error building trees". Los tests siempre
  # corren con su propio indice.
  if command -v npx >/dev/null 2>&1; then
    env -u GIT_INDEX_FILE npx bats "${SCRIPT_DIR}/tests/bash" || exit 1
  fi

  # Python functional tests (pytest)
  if command -v pytest >/dev/null 2>&1; then
    env -u GIT_INDEX_FILE pytest "${SCRIPT_DIR}/tests/python" || exit 1
  fi

  # Node functional tests (2026-10-06). Antes tests/node/ existia y NO corria en
  # ningun lado (solo bats y pytest estaban cableados). El runner es el punto de
  # entrada unico; cada *.test.js es autonomo y falla con exit != 0.
  if command -v node >/dev/null 2>&1; then
    env -u GIT_INDEX_FILE "${SCRIPT_DIR}/tests/node/run.sh" || exit 1
  fi
fi
