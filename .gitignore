# Workspace .gitignore

# macOS
.DS_Store

# OpenClaw state (machine-specific)
openclaw-workspace-state.json

# Plugin compaction-context (snapshot transitorio de la compactacion)
RECENT.md
.compaction-recovery-pending

# Node (belt and suspenders - projects have their own .gitignore too)
node_modules/
.next/
dist/
build/
.turbo/

# Databases (local dev)
*.db
*.db-journal

# Excepción: la DB de memoria del workspace SÍ se versiona (sincroniza entre máquinas)
!memory/memory.db

# Env files
.env
.env.local
.env.*.local

# Test artifacts
coverage/
playwright-report/
test-results/
.vitest-cache/
__pycache__/
*.pyc
.pytest_cache/

# Heartbeat noise (empty sessions, no real content)
memory/2026-07-20-1750*.md
memory/2026-07-23-1951.md

# Proyectos - cada uno tiene su propio repo, se sincronizan por separado
# En el workspace SOLO trackeamos .knowledge/ (memoria institucional: BRIEF, ROADMAP,
# STATUS, ADRs, decisiones) para poder planificar y trabajar conceptualmente con todos
# los proyectos sin clonar cada repo. El codigo/README/.env viven en el repo del proyecto.
#
# Doble-git: .knowledge/ viaja SOLO en el workspace (privado). En el repo de cada proyecto
# (publico o privado) el .knowledge/ NO va - cada proyecto lo excluye con su propio .gitignore.
# En cada maquina puede haber: solo .knowledge/, o .knowledge/ + el repo clonado en el mismo slug.
# Al sincronizar entre maquinas, los .knowledge/ se COMBINAN (merge), no se pisan.

# Ignorar TODO projects/ por defecto
/projects/*

# Permitir el directorio raiz de cada proyecto (para poder negar contenido adentro)
!/projects/*/

# Ignorar el CONTENIDO de cada proyecto (segundo nivel: codigo, README, etc.)
/projects/*/*

# Pero trackear SOLO .knowledge/ de cualquier proyecto (patron global, no listar por proyecto)
!/projects/*/.knowledge/
!/projects/*/.knowledge/**

# El repo embebido en si (su .git) nunca viaja: solo su .knowledge/. Sin esta negacion
# el `git add -A` stagea el directorio como gitlink (commit 160000) y no el arbol de memoria.
/projects/*/.git/

# kanam-tetris: repo publico independiente (gonzoblasco/kanam-tetris). Igual que kanam-skills,
# vive entero en GitHub y su .knowledge/ NO se trackea en el workspace.
/projects/kanam-tetris

# kanam-skills: repo publico independiente, vive entero en GitHub.
# Su .knowledge/ se trackea igual que el de cualquier proyecto (patron global arriba).
# El resto (codigo, web) no viaja en el workspace.

# Proyectos sin .knowledge/ en el workspace (ya archivados o sin memoria propia):
# el codigo vive en GitHub + en el agregado projects_openclaw. Sin trackear aca para
# evitar ruido de untracked al clonar/reclonar (checkout local util, no parte del repo).
/projects/accessible-ui/
/projects/ai-developer-stack/
/projects/create-with-ai/

# Antigua estructura products/ (migrada a projects/<slug>/docs/)
products/

# Editor
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class

projects/cabala

# Repo embebido - tiene su propio repo, no trackear
umbrawriter-v2
umbrawriter-v2/

# Repos git embebidos: se trackea SOLO su .knowledge/ (ya en el index).
# El patron global arriba (/projects/*/* + !/projects/*/.knowledge/) ya cubre estos repos:
# ignora el codigo del repo y permite el .knowledge/. No listar por proyecto (rompe el git add de .knowledge/).
# Excepcion: kanam-skills es repo publico independiente - su .knowledge/ (assets) NO se trackea en el workspace.
/projects/kanam-skills

# Forks de terceros: repos ajenos donde se contribuye (TanStack, shadcn, etc.)
# Se ignoran AL 100% - no llevan .knowledge/ (no se modifica el .gitignore de proyectos ajenos).
# El repo del fork vive por si solo; la memoria de la sesion va a docs/ o memory/.
/forks/*
/forks/*/
/forks/*/**

# clones/: repos de terceros con pull total (no forks especificos). NO se commitea.
# La memoria/deliverables de la sesion van a docs/ o memory/ del workspace.
/clones/*
/clones/*/
/clones/*/**

# sandbox/: pruebas temporales y analisis aislado. NO se commitea.
sandbox/

# Session logs automaticos de OpenClaw (memory/YYYY-MM-DD-HHMM.md) - no se commitean.
memory/*-[0-9][0-9][0-9][0-9].md
writings/

# Chunks derivados de memoria (indice semantic highlighting, regenerable)
memory/export/

# Pipeline state (mutable working state, not versioned - kanam-pulse etc.)
pipeline-state.json

# Repos embebidos de proyectos: ignorar su .git/ para que el workspace los vea como dirs normales
# (si no, git los trata como gitlink y no desciende al .knowledge/)
/projects/*/.git/

# OpenClaw dreaming state (local, machine-specific)
DREAMS.md
memory/.dreams/
memory/dreaming/

# projects_openclaw: repo agregado privado con el codigo fuente de todos los proyectos
# (copia de projects/ sin .git ni node_modules). Vive aparte, no se versiona en el workspace.
projects_openclaw/

# Temp working files (recreation experiments, scratch)
tmp/
