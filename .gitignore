# Workspace .gitignore

# macOS
.DS_Store

# OpenClaw state (machine-specific)
openclaw-workspace-state.json

# Node (belt and suspenders — projects have their own .gitignore too)
node_modules/
.next/
dist/
build/
.turbo/

# Databases (local dev)
*.db
*.db-journal

# Env files
.env
.env.local
.env.*.local

# Test artifacts
coverage/
playwright-report/
test-results/
.vitest-cache/

# Heartbeat noise (empty sessions, no real content)
memory/2026-07-20-1750*.md
memory/2026-07-23-1951.md

# Proyectos — cada uno tiene su propio repo, se sincronizan por separado
# Regla: ignorar todo el contenido de projects/ EXCEPTO:
#   - .knowledge/ (memoria de sesión)
#   - README.md (descripción del proyecto, visible desde el workspace)
#   - *-knowledge/ (memoria externa para proyectos con git propio)
projects/*
!projects/*/
projects/*/*
!projects/*/.knowledge/
!projects/*/.knowledge/**
!projects/*/README.md
!projects/*-knowledge/
!projects/*-knowledge/**
# Ignorar .git internos de proyectos (evita submódulos automáticos)
.git
projects/**/.git

# Antigua estructura products/ (migrada a projects/<slug>/docs/)
products/

# Editor
.idea/
*.swp
*.swo