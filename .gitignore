# Workspace .gitignore

# macOS
.DS_Store

# OpenClaw state (machine-specific)
openclaw-workspace-state.json

# Node (belt and suspenders — projects have their own .gitignore too)
node_modules/
.next/
dist/
build/
.turbo/

# Databases (local dev)
*.db
*.db-journal

# Excepción: la DB de memoria del workspace SÍ se versiona (sincroniza entre máquinas)
!memory/memory.db

# Env files
.env
.env.local
.env.*.local

# Test artifacts
coverage/
playwright-report/
test-results/
.vitest-cache/

# Heartbeat noise (empty sessions, no real content)
memory/2026-07-20-1750*.md
memory/2026-07-23-1951.md

# Proyectos — cada uno tiene su propio repo, se sincronizan por separado
# Los submodules (declarados en .gitmodules) se trackean automaticamente.
# Para proyectos sin submodule, solo trackeamos lo necesario.

# Ignorar todo projects/ por defecto
/projects/*

# Pero NO ignorar los directorios en si (para poder trackear submodules y .knowledge)
!/projects/*/

# Ignorar contenido de proyectos NO-submodule (daily-ink, ensulugar, etc.)
/projects/daily-ink/*
/projects/ensulugar/*
/projects/godot-journey/*
/projects/kanam/*
/projects/kanam-story/*
/projects/learning-js-ds-algos/*
/projects/remix-book/*
/projects/soporteml-v2/*
/projects/soporteml-v3/*
/projects/sportcars/*
/projects/testing-react-library/*
/projects/kanam-forge/*

# kanam-skills: repo público independiente, vive entero en GitHub
/projects/kanam-skills

# Pero trackear .knowledge/ y README.md en esos proyectos
!/projects/daily-ink/.knowledge/
!/projects/daily-ink/.knowledge/**
!/projects/daily-ink/README.md
!/projects/ensulugar/.knowledge/
!/projects/ensulugar/.knowledge/**
!/projects/ensulugar/README.md
!/projects/godot-journey/.knowledge/
!/projects/godot-journey/.knowledge/**
!/projects/godot-journey/README.md
!/projects/kanam/.knowledge/
!/projects/kanam/.knowledge/**
!/projects/kanam/README.md
!/projects/kanam-story/.knowledge/
!/projects/kanam-story/.knowledge/**
!/projects/kanam-story/README.md
!/projects/learning-js-ds-algos/.knowledge/
!/projects/learning-js-ds-algos/.knowledge/**
!/projects/learning-js-ds-algos/README.md
!/projects/remix-book/.knowledge/
!/projects/remix-book/.knowledge/**
!/projects/remix-book/README.md
!/projects/soporteml-v2/.knowledge/
!/projects/soporteml-v2/.knowledge/**
!/projects/soporteml-v2/README.md
!/projects/soporteml-v3/.knowledge/
!/projects/soporteml-v3/.knowledge/**
!/projects/soporteml-v3/README.md
!/projects/sportcars/.knowledge/
!/projects/sportcars/.knowledge/**
!/projects/sportcars/README.md
!/projects/testing-react-library/.knowledge/
!/projects/testing-react-library/.knowledge/**
!/projects/testing-react-library/README.md
!/projects/kanam-forge/.knowledge/
!/projects/kanam-forge/.knowledge/**
!/projects/kanam-forge/README.md
# .env* del proyecto viven en el repo del proyecto, no en el workspace
/projects/kanam-forge/.env*

# Antigua estructura products/ (migrada a projects/<slug>/docs/)
products/

# Editor
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class

projects/cabala

# Repo embebido - tiene su propio repo, no trackear
umbrawriter-v2
umbrawriter-v2/
