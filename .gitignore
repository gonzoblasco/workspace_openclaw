# Workspace .gitignore

# macOS
.DS_Store

# OpenClaw state (machine-specific)
openclaw-workspace-state.json

# Plugin compaction-context (snapshot transitorio de la compactacion)
RECENT.md
.compaction-recovery-pending

# Node (belt and suspenders - projects have their own .gitignore too)
node_modules/
.next/
dist/
build/
.turbo/

# Databases (local dev)
*.db
*.db-journal
# Backups de migraciones: son locales, pesan MB y no deben sincronizarse.
# (memory.db si se versiona: ver la excepcion de abajo.)
*.db.pre-vector-blob
*.db.pre-*

# Excepción: la DB de memoria del workspace SÍ se versiona (respaldo de la fuente de verdad, ADR-084/085)
!memory/memory.db

# El índice vectorial NO se versiona (ADR-108): es derivado y reconstruible.
# Vive al lado de memory.db, local. Reconstruir: python3 scripts/memory-reembed.py --all
memory/vectors.db
memory/vectors.db-journal
memory/vectors.db-wal
memory/vectors.db-shm

# Env files
.env
.env.local
.env.*.local

# Test artifacts
coverage/
playwright-report/
test-results/
.vitest-cache/
__pycache__/
*.pyc
.pytest_cache/

# Proyectos - viven DENTRO del workspace (ADR-098, supersede ADR-075).
# El workspace hospeda projects/ como espacio comun de todos los agentes; el
# Home llega via symlink (~/projects -> .openclaw/workspace/projects).
# Se ignora la ruta al 100%: projects/ es una carpeta plana (NO es repo); cada
# proyecto es su propio .git. Sin esta regla, git absorberia los proyectos como
# gitlinks/submodules implicitos. No trackear aca.
/projects/

# Editor
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class

# Forks de terceros: repos ajenos donde se contribuye (TanStack, shadcn, etc.)
# Se ignoran AL 100% - no llevan .knowledge/ (no se modifica el .gitignore de proyectos ajenos).
# El repo del fork vive por si solo; la memoria de la sesion va a docs/ o memory/.
/forks/*
/forks/*/
/forks/*/**

# services/: repos de terceros que corren como SERVICIO INTERNO (vane, etc.).
# No se les manda PR: se los opera. El codigo se ignora como forks/; la
# diferencia es que su `.knowledge/` si se trackea, pero en SU repo
# (gonzoblasco/<servicio>), no en el del upstream ni aca. (2026-11-03)
/services/*
/services/*/
/services/*/**

# clones/: repos de terceros con pull total (no forks especificos). NO se commitea.
# La memoria/deliverables de la sesion van a docs/ o memory/ del workspace.
/clones/*
/clones/*/
/clones/*/**

# _workbench/: proyectos propios SIN copia remota todavia (pendientes de repo en GitHub).
# No se mezclan con projects/ para no dar por respaldado lo que no lo esta.
/_workbench/
/_workbench/*/

# oss/: contribuciones a repos ajenos (facebook/astryx, TanStack/router, ...).
# NO lleva regla de ignore A PROPOSITO. A diferencia de forks/ y clones/ -que son
# codigo de terceros y no se commitean- lo que vive aca es NUESTRO registro
# (HANDOFF, SESSIONS, THREADS) y se versiona con el workspace, igual que
# memory/ y docs/. Ignorarlo lo dejaria sin respaldo: el motivo de crear oss/
# fue que la memoria del hilo sobreviva al clone, y un archivo que solo existe
# en este disco no sobrevive a nada. (2026-11-03)

# playground/: pruebas temporales y analisis aislado. NO se commitea.
# (nombre 2026-10-09: antes 'sandbox/', renombrado para no confundir con 'sandbox.mode' del gateway)
playground/

# Session logs automaticos de OpenClaw (memory/YYYY-MM-DD-HHMM.md) - no se commitean.
# Anclado a la raiz (un solo * no cruza /): archive/sessions/ SI se versiona.
# Incluye el sufijo -N (memory/2026-08-29-2345-2.md).
memory/*-[0-9][0-9][0-9][0-9].md
memory/*-[0-9][0-9][0-9][0-9]-*.md
writings/

# Chunks derivados de memoria (indice semantic highlighting, regenerable)
memory/export/

# Pipeline state (mutable working state, not versioned - kanam-pulse etc.)
pipeline-state.json
model-router.json

# Session plan (estado mutable de la sesion en curso, no versionado)
.session_plan.json

# OpenClaw dreaming state (local, machine-specific)
DREAMS.md
**/memory/.dreams/
**/memory/dreaming/

# Temp working files (recreation experiments, scratch)
tmp/
tmp-design/

# Hand-off history fallback trash (local .trash directory inside the handoff-history).
# Con ** para cubrir tambien los proyectos (ADR-098): cada proyecto tiene su
# propio .knowledge/handoff-history/.trash/.
**/.knowledge/handoff-history/.trash/

# .trash/ de la raiz: backups de reconciliaciones y merges. Es una papelera, no
# un archivo: nunca se versiona. Por no tener esta regla, 42 archivos del
# residuo de octubre quedaron commiteados y reaparecieron como bajas el
# 2026-11-03, cinco semanas despues. Una papelera versionada es deuda que se
# paga sola. (2026-11-03)
/.trash/

# Large autogenerated directories that should never be versioned
**/node_modules/
**/__pycache__/
**/.venv/
.openclaw/trajectory-exports/

# Artefactos generados por corridas locales de skills de auditoria (capturas de
# violaciones a11y, diffs de pixel-diff). NO se versionan: son output de una
# corrida contra una app concreta, no fuente. Los ejemplos declarados a mano
# bajo examples/ si se versionan (son documentacion del formato de salida).
#
# `/reports/` (raiz) es el destino que declara `.kanam/pipeline.config.yaml`
# (`output.dir: ./reports/surface-audit`, relativo a la raiz del repo). Sin esta
# regla, correr el surface-pipeline creaba un /reports/ sin ignorar: el hueco
# que la auditoria del 2026-10-12 encontro en el propio cambio del 2026-10-07.
/reports/
agents/*/skills/*/reports/

# Locks de escritura concurrente (lockutil.py, B6) - runtime, no se versiona
.openclaw/locks/

# Large PDFs (Mercor handbook: 26MB)
docs/entrevistas/**/*.pdf
